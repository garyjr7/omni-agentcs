# Perfil explícito: cargar mediante el mecanismo de configuración del despliegue.
# DEEPSEEK_API_KEY debe suministrarse desde el entorno/gestor de secretos.
NEXUS_LLM_DEFAULT_PROVIDER=deepseek
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Presupuestos locales POR PROCESO; no son cuotas oficiales del proveedor.
DEEPSEEK_TPM=1000000
DEEPSEEK_RPM=60
NEXUS_LLM_TPM_PACING=1
NEXUS_LLM_BACKOFF_SECONDS=2
# Latencia: lectura máxima de una completion (mínimo 120) e intentos totales ante
# timeout/corte transitorio o gateway 5xx. El router conserva una guarda exterior.
DEEPSEEK_TIMEOUT=180
DEEPSEEK_MAX_ATTEMPTS=4
NEXUS_LLM_REQUEST_TIMEOUT=300
