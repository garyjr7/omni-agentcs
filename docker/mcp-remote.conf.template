limit_req_zone $binary_remote_addr zone=nexus_mcp:10m rate=30r/m;

upstream nexus_mcp_remote {
    server mcp-remote:8000;
    keepalive 16;
}

server {
    listen 8443 ssl;
    server_name ${NEXUS_MCP_SERVER_NAME};

    ssl_certificate /etc/nexus/tls/tls.crt;
    ssl_certificate_key /etc/nexus/tls/tls.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;

    server_tokens off;
    client_max_body_size 4m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Cache-Control "no-store" always;

    location = /mcp {
        limit_req zone=nexus_mcp burst=10 nodelay;
        limit_except GET POST DELETE OPTIONS { deny all; }
        proxy_pass http://nexus_mcp_remote;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Request-ID $request_id;
    }

    location ^~ /.well-known/ {
        limit_req zone=nexus_mcp burst=5 nodelay;
        limit_except GET OPTIONS { deny all; }
        proxy_pass http://nexus_mcp_remote;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location / { return 404; }
}
