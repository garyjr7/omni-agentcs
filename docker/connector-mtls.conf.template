upstream nexus_connector_api {
    server backend:8000;
    keepalive 16;
}

server {
    listen 8443 ssl;
    server_name _;

    ssl_certificate /etc/nexus/pki/server.crt;
    ssl_certificate_key /etc/nexus/pki/server.key;
    ssl_client_certificate /etc/nexus/pki/client-ca.crt;
    ssl_verify_client on;
    ssl_verify_depth 2;
    ssl_protocols TLSv1.2 TLSv1.3;

    location /connectors/ {
        proxy_pass http://nexus_connector_api;
        proxy_set_header Host $host;
        proxy_set_header X-Client-Cert-SHA256 $ssl_client_fingerprint;
        proxy_set_header X-Nexus-Connector-Proxy-Secret "${NEXUS_CONNECTOR_PROXY_SECRET}";
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 30s;
    }

    location / {
        return 404;
    }
}
