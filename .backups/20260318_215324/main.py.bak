# ══════════════════════════════════════════════════════════════
# ENDPOINTS BASE
# ══════════════════════════════════════════════════════════════

@app.get("/health", tags=["💚 Health"])
async def health():
    """Health check — estado completo del sistema."""
    from datetime import datetime

    services = {}

    # Verificar orchestrator
    services["orchestrator"] = "ok" if getattr(app.state, "orchestrator", None) else "degraded"
    services["llm"]          = "ok" if getattr(app.state, "llm", None) else "degraded"
    services["memory"]       = "ok" if getattr(app.state, "memory", None) else "degraded"
    services["registry"]     = "ok" if getattr(app.state, "registry", None) else "degraded"
    services["event_bus"]    = "ok" if getattr(app.state, "event_bus", None) else "degraded"
    services["junior_bridge"]= "ok" if getattr(app.state, "junior_bridge", None) else "degraded"

    all_ok = all(v == "ok" for v in services.values())

    return {
        "status": "healthy" if all_ok else "degraded",
        "version": "2.0.0",
        "timestamp": datetime.utcnow().isoformat(),
        "platform": "NEXUS PRO — AI Operations Platform",
        "services": services,
    }


@app.get("/", tags=["💚 Health"])
async def root():
    return {
        "name": "NEXUS PRO",
        "version": "2.0.0",
        "status": "online",
        "docs": "/docs",
        "health": "/health",
    }
