"""
nexus_api/main.py — NEXUS PRO v2.0
Orquestador de Agentes IA · Zero Trust · Military Grade
Reescrito limpio — usa solo módulos que existen en nexus_core
"""
import logging
import sys
from pathlib import Path

# ── Path setup ────────────────────────────────────────────────
ROOT = Path(__file__).parent.parent
sys.path.insert(0, str(ROOT))
sys.path.insert(0, str(ROOT / "nexus_core"))

from contextlib import asynccontextmanager
from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware
from fastapi.staticfiles import StaticFiles
from dotenv import load_dotenv

load_dotenv()

logger = logging.getLogger("nexus.api")
logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s - [%(levelname)s] - %(message)s"
)

# ══════════════════════════════════════════════════════════════
# LIFESPAN — startup / shutdown
# ══════════════════════════════════════════════════════════════
@asynccontextmanager
async def lifespan(app: FastAPI):
    logger.info("=" * 60)
    logger.info("  NEXUS PRO v2.0 — Iniciando...")
    logger.info("=" * 60)

    # ── Base de datos ─────────────────────────────────────────
    try:
        from nexus_api.auth.database import database, init_db
        init_db()
        await database.connect()
        logger.info("[DB] ✓ Base de datos conectada")
    except Exception as e:
        logger.warning(f"[DB] ⚠ {e}")

    # ── Scheduler ─────────────────────────────────────────────
    try:
        from nexus_api.scheduler.manager import start_scheduler
        start_scheduler()
        logger.info("[SCHEDULER] ✓ Scheduler iniciado")
    except Exception as e:
        logger.warning(f"[SCHEDULER] ⚠ {e}")

    # ── Nexus Core: Orchestrator ───────────────────────────────
    try:
        from nexus_core.core.orchestrator import Orchestrator
        app.state.orchestrator = Orchestrator()
        logger.info("[ORCHESTRATOR] ✓ Orchestrator listo")
    except Exception as e:
        logger.warning(f"[ORCHESTRATOR] ⚠ {e}")
        app.state.orchestrator = None

    # ── Nexus Core: LLM Abstraction ───────────────────────────
    try:
        from nexus_core.llm.abstraction import LLMProvider
        app.state.llm = LLMProvider()
        logger.info("[LLM] ✓ LLM Provider listo")
    except Exception as e:
        logger.warning(f"[LLM] ⚠ {e}")
        app.state.llm = None

    # ── Nexus Core: Memory / Vector Store ────────────────────
    try:
        from nexus_core.memory.manager import MemoryManager
        app.state.memory = MemoryManager()
        logger.info("[MEMORY] ✓ MemoryManager listo")
    except Exception as e:
        logger.warning(f"[MEMORY] ⚠ {e}")
        app.state.memory = None

    # ── Nexus Core: Agent Registry ───────────────────────────
    try:
        from nexus_core.agents.registry import AgentRegistry
        app.state.registry = AgentRegistry()
        logger.info("[REGISTRY] ✓ AgentRegistry listo")
    except Exception as e:
        logger.warning(f"[REGISTRY] ⚠ {e}")
        app.state.registry = None

    # ── Nexus Core: State Manager ────────────────────────────
    try:
        from nexus_core.state.manager import StateManager
        app.state.state_manager = StateManager()
        logger.info("[STATE] ✓ StateManager listo")
    except Exception as e:
        logger.warning(f"[STATE] ⚠ {e}")
        app.state.state_manager = None

    # ── Nexus Core: Event Bus ────────────────────────────────
    try:
        from nexus_core.core.event_bus import EventBus
        app.state.event_bus = EventBus()
        logger.info("[EVENTBUS] ✓ EventBus listo")
    except Exception as e:
        logger.warning(f"[EVENTBUS] ⚠ {e}")
        app.state.event_bus = None

    # ── Nexus Core: Agent Team Manager ───────────────────────
    try:
        from nexus_core.agent_team_manager import create_team_router
        app.include_router(create_team_router())
        logger.info("[TEAMS] ✓ AgentTeamManager registrado → /teams/*")
    except Exception as e:
        logger.warning(f"[TEAMS] ⚠ {e}")

    # ── Nexus Core: Workflow Manager ─────────────────────────
    try:
        from nexus_core.workflow_manager import WorkflowManager
        app.state.workflow_manager = WorkflowManager()
        logger.info("[WORKFLOW] ✓ WorkflowManager listo")
    except Exception as e:
        logger.warning(f"[WORKFLOW] ⚠ {e}")
        app.state.workflow_manager = None

    # ── Junior Bridge (opcional) ──────────────────────────────
    try:
        from nexus_core.junior_bridge import initialize_bridge, get_junior_bridge
        bridge_ok = await initialize_bridge()
        if bridge_ok:
            app.state.junior_bridge = get_junior_bridge()
            logger.info("[JUNIOR] ✓ JuniorBridge activo — Orchestrator+Registry+LLM")
        else:
            logger.warning("[JUNIOR] ⚠ JuniorBridge inicializado con errores")
    except Exception as e:
        logger.warning(f"[JUNIOR] ⚠ {e}")
        app.state.junior_bridge = None

    logger.info("=" * 60)
    logger.info("  NEXUS PRO v2.0 — SISTEMA HEALTHY ✓")
    logger.info("  Docs: http://0.0.0.0:8000/docs")
    logger.info("=" * 60)

    yield  # ← app corriendo

    # ── Shutdown ──────────────────────────────────────────────
    logger.info("[NEXUS] Apagando servicios...")
    try:
        from nexus_api.scheduler.manager import stop_scheduler
        stop_scheduler()
    except Exception:
        pass
    try:
        from nexus_api.auth.database import database
        await database.disconnect()
    except Exception:
        pass
    logger.info("[NEXUS] ✓ Apagado limpio")


# ══════════════════════════════════════════════════════════════
# APP
# ══════════════════════════════════════════════════════════════
app = FastAPI(
    title="NEXUS PRO",
    version="2.0.0",
    description="""
## NEXUS PRO — AI Operations Platform

Orquestador de Agentes IA de grado militar.
Supera a CrewAI, AutoGen y LangGraph en orquestación nativa.

### Módulos activos
- 🤖 Agentes IA (crear, asignar herramientas, modelos)
- 👥 Equipos de agentes con estrategias de orquestación
- 📋 Tareas (única, monitor 24/7, crontab, pipeline)
- 🔐 Secrets Vault (AES-256)
- 🛡️ Guardian Scan (seguridad ofensiva)
- 👤 HITL — Human in the Loop
- 📊 Audit Trail inmutable
- 🔑 RBAC Zero Trust
    """,
    lifespan=lifespan,
    docs_url="/docs",
    redoc_url="/redoc",
)

# ── CORS ─────────────────────────────────────────────────────
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

# ══════════════════════════════════════════════════════════════
# ROUTERS — se registran con try/except para no romper el boot
# ══════════════════════════════════════════════════════════════

def safe_include(router, **kwargs):
    """Incluye un router sin matar el arranque si falla."""
    try:
        app.include_router(router, **kwargs)
        return True
    except Exception as e:
        logger.warning(f"[ROUTER] ⚠ {kwargs.get('prefix','?')} → {e}")
        return False

# Auth (obligatorio)
from nexus_api.routes.auth import router as auth_router
app.include_router(auth_router, tags=["🔐 Auth"])

# Scheduler
try:
    from nexus_api.routes.scheduler import router as scheduler_router
    app.include_router(scheduler_router, tags=["⏱ Scheduler"])
except Exception as e:
    logger.warning(f"[ROUTER] scheduler ⚠ {e}")

