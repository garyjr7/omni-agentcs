{
  "nikto": {
    "description": "Nikto web scanner", "purpose": "Diagnóstico web",
    "verify": ["nikto", "-Version"],
    "recipes": {"apt": {"command": ["apt", "install", "-y", "nikto"], "sudo": true}}
  },
  "nmap": {
    "description": "Port scanner", "purpose": "Puertos y servicios",
    "verify": ["nmap", "--version"],
    "recipes": {
      "apt": {"command": ["apt", "install", "-y", "nmap"], "sudo": true},
      "dnf": {"command": ["dnf", "install", "-y", "nmap"], "sudo": true},
      "yum": {"command": ["yum", "install", "-y", "nmap"], "sudo": true},
      "pacman": {"command": ["pacman", "-S", "--noconfirm", "nmap"], "sudo": true},
      "zypper": {"command": ["zypper", "--non-interactive", "install", "nmap"], "sudo": true},
      "brew": {"command": ["brew", "install", "nmap"], "sudo": false},
      "port": {"command": ["port", "install", "nmap"], "sudo": true}
    }
  },
  "subfinder": {
    "description": "Subdomain enumeration", "purpose": "Recon pasivo OSINT",
    "verify": ["subfinder", "-version"],
    "recipes": {
      "go": {"command": ["go", "install", "-v", "github.com/projectdiscovery/subfinder/v2/cmd/subfinder@latest"], "sudo": false, "installs_to": "~/go/bin/subfinder"},
      "brew": {"command": ["brew", "install", "subfinder"], "sudo": false}
    }
  },
  "httpx": {
    "description": "ProjectDiscovery HTTP toolkit (no es el paquete Python)", "purpose": "Sondeo HTTP",
