# OmniAgentCS-CLI: optional overrides; global config uses XDG by default.
# Copy only settings you need. Environment/.env take precedence over config.toml.
# Proveedor LLM. Una clave real (GROQ_API_KEY, OPENAI_API_KEY, ...) gana sobre
# este valor: 'fake' solo se usa si no hay ningún proveedor real configurado.
LLM_PROVIDER=fake
FAKE_LLM_MODEL=nexus-fake-v1
# Nivel de log del CLI. Opciones: debug, info, warning, error.
# Por defecto: warning (silencia los logs internos de los clientes LLM).
NEXUS_LOG_LEVEL=warning
# Preferente: guarda las claves con `/secrets set NOMBRE` (keyring del SO o
# fichero 0600) y deja estos valores vacíos. El store tiene prioridad sobre
# .env; las claves del entorno explícito siguen ganando a todo.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# DeepSeek (opcional). El cliente eleva el timeout de lectura por encima de los
# 60 s históricos y reintenta cortes transitorios con backoff exponencial; los
# presupuestos son política local del proceso, no cuotas oficiales del servicio.
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# Lectura máxima de una completion, en segundos (mínimo 120; por defecto 180).
# DEEPSEEK_TIMEOUT=180
# Intentos totales del cliente (1 = sin reintentos; por defecto 4).
# DEEPSEEK_MAX_ATTEMPTS=4
# DEEPSEEK_TPM=1000000
# DEEPSEEK_RPM=60
# Guarda exterior del router de políticas; debe superar el timeout del cliente.
# NEXUS_LLM_REQUEST_TIMEOUT=300
# Directorio de binarios de usuario añadido al PATH del sandbox (default ~/.local/bin).
# NEXUS_TOOL_BIN_DIR=/absolute/path/bin
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3

NEXUS_ENV=development
# Leave database overrides unset to use XDG or config.toml.
# NEXUS_DB_PATH=/absolute/path/control.db
# DATABASE_URL=postgresql://user:password@localhost/omni
# XDG_CONFIG_HOME=/absolute/path/config
# XDG_DATA_HOME=/absolute/path/data
# XDG_STATE_HOME=/absolute/path/state
# XDG_CACHE_HOME=/absolute/path/cache
NEXUS_SCOPE_SIGNING_SECRET=
NEXUS_ALLOW_MODEL_FALLBACK=false
# Production OCI sandbox; development requires the documented local sandbox.
NEXUS_OCI_RUNTIME=docker
NEXUS_SANDBOX_IMAGES=python:3.12-alpine
# Modo de sandbox explícito: local | local_strict | oci | oci_network.
# Si se omite: development→local_strict y production→oci.
# oci_network requiere NEXUS_EGRESS_PROXY y NEXUS_SANDBOX_NETWORK; si falta
# cualquiera de los dos, falla cerrado (docs/adr/ADR-004).
NEXUS_SANDBOX_MODE=
# Fallback de montaje del kernel en nexus.recon.nfs cuando el cliente userland
# (nfs-ls) es rechazado con NFS3ERR_ACCES. Reutiliza sin sudo el montaje que el
# operador ya hizo; si no lo hay, ejecuta `sudo -n mount` (exige NOPASSWD).
# Pon "off" para desactivar el fallback.
NEXUS_NFS_MOUNT=
OTEL_SERVICE_NAME=omni
OTEL_EXPORTER_OTLP_ENDPOINT=

# Existing local MessagePack daemon; secrets are never committed.
MSF_RPC_URL=http://127.0.0.1:55552
MSF_RPC_USER=msf
MSF_RPC_PASSWORD=
MSF_RPC_TRANSPORT=msgpack
# Host de callback para payloads reverse_tcp (usado por msf_exploit).
# Debe ser una IP alcanzable desde el target; el modelo nunca la elige.
# En Kali suele ser la IP de tun0 (VPN); el wizard de primer arranque la
# autodetecta (`ip -o -4 addr show tun0`) y la escribe en este fichero. Si no
# hay tun0, déjala vacía y exporta MSF_LHOST con una IP alcanzable: sin ella
# toda tool con payload reverse queda `unavailable` (y `omni --doctor` lo
# avisa antes de lanzar el run).
MSF_LHOST=
MSF_LPORT=4444

# Sliver C2 (nexus.c2.*). El bridge conecta al team server por gRPC/mTLS.
# SLIVER_OPERATOR_CONFIG apunta al .cfg del operador generado con
#   sliver-server operator --name <op> --lhost <host> --save <ruta>.cfg
# Si está vacío o el fichero no existe, las tools fallan cerrado (verified=False).
SLIVER_OPERATOR_CONFIG=
# Timeout de cada llamada gRPC, en segundos.
SLIVER_TIMEOUT=30
# Host y puerto del servicio "multiplayer" del team server.
SLIVER_LHOST=127.0.0.1
SLIVER_LPORT=31337
# NEXUS_NUCLEI_TEMPLATES=/absolute/path/nuclei-templates
# Desactiva la TUI y usa readline (scripts o terminales antiguos).
# Se activa automáticamente el fallback si stdin o stdout no es TTY.
NEXUS_NO_TUI=
# Tarifas opcionales del modelo activo, USD por millón de tokens.
# Sin ambas tarifas, la barra muestra $— (no inventa precios).
NEXUS_TUI_INPUT_USD_PER_MTOK=
NEXUS_TUI_OUTPUT_USD_PER_MTOK=
# Presupuesto de tokens por run del agente ReAct.
# 0 = sin límite. Recomendado: 50000 para control de coste.
# Si el run lo supera, termina con estado budget_exceeded (no rompe el run).
NEXUS_RUN_BUDGET_TOKENS=0
