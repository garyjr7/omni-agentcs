"""
Scheduler de agentes con APScheduler.
Permite programar tareas recurrentes para los agentes Nexus.
"""
import logging
from datetime import datetime
from typing import Callable, Dict, Any, Optional

from apscheduler.schedulers.asyncio import AsyncIOScheduler
from apscheduler.triggers.cron import CronTrigger
from apscheduler.triggers.interval import IntervalTrigger
from apscheduler.jobstores.memory import MemoryJobStore

logger = logging.getLogger("nexus.scheduler")

scheduler = AsyncIOScheduler(
    jobstores={"default": MemoryJobStore()},
    timezone="America/Mexico_City",
)

_job_registry: Dict[str, Dict[str, Any]] = {}


def start_scheduler():
    if not scheduler.running:
        scheduler.start()
        logger.info("Scheduler iniciado")


def stop_scheduler():
    if scheduler.running:
        scheduler.shutdown(wait=False)
        logger.info("Scheduler detenido")


def add_interval_job(
    job_id: str,
    func: Callable,
    seconds: int = 60,
    name: str = "",
    kwargs: Optional[dict] = None,
) -> dict:
    """Agrega un job con intervalo en segundos."""
    if scheduler.get_job(job_id):
        scheduler.remove_job(job_id)

    scheduler.add_job(
        func,
        trigger=IntervalTrigger(seconds=seconds),
        id=job_id,
        name=name or job_id,
        kwargs=kwargs or {},
        replace_existing=True,
    )
    _job_registry[job_id] = {
        "id": job_id,
        "name": name or job_id,
        "type": "interval",
        "seconds": seconds,
        "created_at": datetime.now().isoformat(),
        "status": "running",
    }
    logger.info(f"Job agregado: {job_id} cada {seconds}s")
    return _job_registry[job_id]


def add_cron_job(
    job_id: str,
    func: Callable,
    cron_expr: str = "0 * * * *",
    name: str = "",
    kwargs: Optional[dict] = None,
) -> dict:
    """Agrega un job con expresión cron."""
    parts = cron_expr.split()
    trigger = CronTrigger(
        minute=parts[0], hour=parts[1] if len(parts) > 1 else "*",
        day=parts[2] if len(parts) > 2 else "*",
        month=parts[3] if len(parts) > 3 else "*",
        day_of_week=parts[4] if len(parts) > 4 else "*",
    )
    scheduler.add_job(
        func,
        trigger=trigger,
        id=job_id,
        name=name or job_id,
        kwargs=kwargs or {},
        replace_existing=True,
    )
    _job_registry[job_id] = {
        "id": job_id,
        "name": name or job_id,
        "type": "cron",
        "cron": cron_expr,
        "created_at": datetime.now().isoformat(),
        "status": "running",
    }
    return _job_registry[job_id]


def remove_job(job_id: str) -> bool:
    job = scheduler.get_job(job_id)
    if job:
        scheduler.remove_job(job_id)
        if job_id in _job_registry:
            _job_registry[job_id]["status"] = "removed"
        return True
    return False


def list_jobs() -> list:
    jobs = []
    for job in scheduler.get_jobs():
        reg = _job_registry.get(job.id, {})
        next_run = job.next_run_time.isoformat() if job.next_run_time else None
        jobs.append({
            "id": job.id,
            "name": job.name,
            "next_run": next_run,
            **reg,
        })
    return jobs
